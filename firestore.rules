// ============================================================
// Barque+ Firestore security rules
//
// These decide who can read and write what. They run on Google's
// side, so nobody can get around them by editing the website.
//
// This file is just a copy for your records. To make rules take
// effect, paste the whole file into:
//   Firebase console > Firestore Database > Rules tab > Publish
// ============================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== TESTING SWITCH =====
    // true  = accounts must verify their email before using the site
    // false = skip email verification (while school email blocks the emails)
    // Keep this the same as REQUIRE_EMAIL_VERIFICATION in js/account.js.
    function verificationRequired() {
      return true;
    }
    // ==========================

    // ============================================================
    // ===== EDITOR LIST: the emails of every Editor account =====
    // Add or remove emails here, then click Publish.
    // Type them in lowercase, in quotes, separated by commas, e.g.
    //   return ['mingze@bsd405.org', 'someone@bsd405.org'];
    function editorEmails() {
      return ['s-shimi@bsd405.org'];
    }
    // ============================================================

    // ---------- Who counts as a Barque+ user ----------
    // Logged in with an @bsd405.org email (verified, if the switch is on).
    function isSchoolUser() {
      return request.auth != null
        && request.auth.token.email.lower().matches('.*@bsd405[.]org$')
        && (request.auth.token.email_verified == true || !verificationRequired());
    }

    // An Editor: a Barque+ user whose email is in the editor list above
    function isEditor() {
      return isSchoolUser() && request.auth.token.email.lower() in editorEmails();
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function myUsername() {
      return request.auth.token.email.lower().split('@')[0];
    }

    // ---------- Profile Types (Steps 15 and 16) ----------
    // Read from your own profile, users/{you} { profileType, clubId }.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isTeacher() {
      return myProfile().get('profileType', 'Student') == 'Teacher';
    }
    // A Club Leader may only edit the one club they lead
    function leadsClub(clubId) {
      return myProfile().get('profileType', 'Student') == 'Club Leader'
        && myProfile().get('clubId', '') == clubId;
    }

    // ---------- Helpers for votes ----------
    function myVotePath(articleId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/votes/$(articleId);
    }
    function statsPath(articleId) {
      return /databases/$(database)/documents/articles/$(articleId);
    }
    // My vote on an article before / after this change: 1, -1, or 0 (no vote)
    function voteBefore(articleId) {
      return exists(myVotePath(articleId)) ? get(myVotePath(articleId)).data.value : 0;
    }
    function voteAfter(articleId) {
      return existsAfter(myVotePath(articleId)) ? getAfter(myVotePath(articleId)).data.value : 0;
    }
    // How much "up" and "down" must change when a vote goes from b to a
    function upChange(b, a) {
      return (a == 1 ? 1 : 0) - (b == 1 ? 1 : 0);
    }
    function downChange(b, a) {
      return (a == -1 ? 1 : 0) - (b == -1 ? 1 : 0);
    }
    // The article's counts after this change match the vote change exactly
    function countsMatchVote(articleId) {
      let b = voteBefore(articleId);
      let a = voteAfter(articleId);
      let oldUp = exists(statsPath(articleId)) ? get(statsPath(articleId)).data.get('up', 0) : 0;
      let oldDown = exists(statsPath(articleId)) ? get(statsPath(articleId)).data.get('down', 0) : 0;
      return a != b
        && existsAfter(statsPath(articleId))
        && getAfter(statsPath(articleId)).data.get('up', 0) - oldUp == upChange(b, a)
        && getAfter(statsPath(articleId)).data.get('down', 0) - oldDown == downChange(b, a);
    }

    // ---------- Today's date in Bellevue (for daily limits) ----------
    // A day number (days since Jan 1 1970) that changes at midnight Pacific
    // time, including daylight saving time (2nd Sunday of March to the
    // 1st Sunday of November). js/qa.js works out the same number.
    function firstSunday(year, month) {
      // dayOfWeek(): Monday = 1 ... Sunday = 7
      return 1 + (7 - timestamp.date(year, month, 1).dayOfWeek()) % 7;
    }
    function pacificOffsetHours() {
      let y = request.time.year();
      let dstStart = timestamp.date(y, 3, firstSunday(y, 3) + 7) + duration.value(10, 'h');  // 2 a.m. PST
      let dstEnd = timestamp.date(y, 11, firstSunday(y, 11)) + duration.value(9, 'h');       // 2 a.m. PDT
      return (request.time >= dstStart && request.time < dstEnd) ? 7 : 8;
    }
    function today() {
      return math.floor((request.time - duration.value(pacificOffsetHours(), 'h')).toMillis() / 86400000);
    }

    // ---------- Daily limits: users/{you}/limits/{kind} = { day, count } ----------
    function limitPath(kind) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/limits/$(kind);
    }
    // How many posts of each kind a Student (or Club Leader) can make per day.
    // Keep these the same as DAILY in js/limits.js.
    //   comments: News comments    qa: Q&A questions + replies    lost: lost items
    function dailyMax(kind) {
      return kind == 'comments' ? 5 : (kind == 'qa' ? 5 : 1);
    }
    // Posts already made today (older records have no count, which means 1)
    function postsToday(kind) {
      return (exists(limitPath(kind)) && get(limitPath(kind)).data.day == today())
        ? get(limitPath(kind)).data.get('count', 1) : 0;
    }
    // A post only counts if the same save moves your count up by exactly one
    // (the limits rule below keeps it within dailyMax).
    function usesTodaysPost(kind) {
      return existsAfter(limitPath(kind))
        && getAfter(limitPath(kind)).data.day == today()
        && getAfter(limitPath(kind)).data.count == postsToday(kind) + 1;
    }
    // Teachers and Editors have no limit on News comments or Q&A
    function withinQALimit() {
      return isEditor() || isTeacher() || usesTodaysPost('qa');
    }
    function withinCommentLimit() {
      return isEditor() || isTeacher() || usesTodaysPost('comments');
    }

    // Lost items: 1 new entry per day for everyone except Editors (Teachers too)
    function withinLostLimit() {
      return isEditor() || usesTodaysPost('lost');
    }

    // ---------- Helpers for Q&A votes ----------
    function myQAVotePath(questionId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/qaVotes/$(questionId);
    }
    function questionPath(questionId) {
      return /databases/$(database)/documents/qa/$(questionId);
    }
    function qaVoteBefore(questionId) {
      return exists(myQAVotePath(questionId)) ? get(myQAVotePath(questionId)).data.value : 0;
    }
    function qaVoteAfter(questionId) {
      return existsAfter(myQAVotePath(questionId)) ? getAfter(myQAVotePath(questionId)).data.value : 0;
    }
    function qaCountsMatchVote(questionId) {
      let b = qaVoteBefore(questionId);
      let a = qaVoteAfter(questionId);
      return a != b
        && exists(questionPath(questionId))
        && existsAfter(questionPath(questionId))
        && getAfter(questionPath(questionId)).data.up - get(questionPath(questionId)).data.up == upChange(b, a)
        && getAfter(questionPath(questionId)).data.down - get(questionPath(questionId)).data.down == downChange(b, a);
    }

    // ---------- User profiles: users/{userId} ----------
    match /users/{userId} {
      // Any Barque+ user can see profiles (needed later for usernames and roles)
      allow read: if isSchoolUser();

      // You can create only your own profile, only once, only as a Student,
      // and only with the username and email that match your account.
      allow create: if isSchoolUser()
        && isOwner(userId)
        && request.resource.data.keys().hasOnly(['username', 'email', 'profileType', 'avatar', 'createdAt'])
        && request.resource.data.profileType == 'Student'
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.username == myUsername()
        && request.resource.data.avatar in ['male', 'female']
        && request.resource.data.createdAt == request.time;

      // After that, you can only change your profile icon, your season theme
      // and your last-visit time. (Editors change Profile Types; see below.)
      allow update: if isSchoolUser()
        && isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar', 'lastSeen', 'theme'])
        && request.resource.data.avatar in ['male', 'female']
        && request.resource.data.get('theme', 'fall') in ['spring', 'summer', 'fall', 'winter']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSeen'])
            || request.resource.data.lastSeen == request.time);

      // Editors can change other accounts' Profile Type (Set Profile Types page).
      // "Editor" itself is only given through the editor list above.
      // A Club Leader also gets clubId (an existing club); others have none.
      allow update: if isEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileType', 'clubId'])
        && request.resource.data.profileType in ['Student', 'Teacher', 'Club Leader']
        && (request.resource.data.profileType == 'Club Leader'
              ? (request.resource.data.clubId is string
                 && exists(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)))
              : !('clubId' in request.resource.data));

      allow delete: if false;

      // ----- Your votes: users/{userId}/votes/{articleId} = { value: 1 or -1 } -----
      // Only you can see or change your votes, and the article's counts must change to match.
      match /votes/{articleId} {
        allow read: if isSchoolUser() && isOwner(userId);
        allow create, update: if isSchoolUser()
          && isOwner(userId)
          && request.resource.data.keys().hasOnly(['value'])
          && request.resource.data.value in [1, -1]
          && countsMatchVote(articleId);
        allow delete: if isSchoolUser()
          && isOwner(userId)
          && countsMatchVote(articleId);
      }

      // ----- Your Q&A votes: users/{userId}/qaVotes/{questionId} = { value: 1 or -1 } -----
      match /qaVotes/{questionId} {
        allow read: if isSchoolUser() && isOwner(userId);
        allow create, update: if isSchoolUser()
          && isOwner(userId)
          && request.resource.data.keys().hasOnly(['value'])
          && request.resource.data.value in [1, -1]
          && qaCountsMatchVote(questionId);
        allow delete: if isSchoolUser()
          && isOwner(userId)
          && qaCountsMatchVote(questionId);
      }

      // ----- Polls you've filled out: users/{userId}/pollsDone/{pollId} = { at } -----
      match /pollsDone/{pollId} {
        allow read: if isSchoolUser() && isOwner(userId);
        allow create: if isSchoolUser()
          && isOwner(userId)
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // ----- Your daily limits: users/{userId}/limits/{kind} = { day, count } -----
      // The count only goes up by one (or restarts at 1 on a new day), never
      // past dailyMax(kind), and the record can never be deleted.
      match /limits/{kind} {
        allow read: if isSchoolUser() && isOwner(userId);
        allow create, update: if isSchoolUser()
          && isOwner(userId)
          && kind in ['comments', 'qa', 'lost']
          && request.resource.data.keys().hasOnly(['day', 'count'])
          && request.resource.data.day == today()
          && request.resource.data.count == postsToday(kind) + 1
          && request.resource.data.count <= dailyMax(kind);
        allow delete: if false;
      }
    }

    // ---------- News articles: articles/{articleId} = { up, down, views } ----------
    match /articles/{articleId} {
      function oldValue(field) {
        return resource == null ? 0 : resource.data.get(field, 0);
      }
      function newValue(field) {
        return request.resource.data.get(field, 0);
      }
      function isOneMoreView() {
        return newValue('views') == oldValue('views') + 1
          && newValue('up') == oldValue('up')
          && newValue('down') == oldValue('down');
      }
      function isVoteChange() {
        let b = voteBefore(articleId);
        let a = voteAfter(articleId);
        return a != b
          && newValue('views') == oldValue('views')
          && newValue('up') - oldValue('up') == upChange(b, a)
          && newValue('down') - oldValue('down') == downChange(b, a);
      }

      allow read: if isSchoolUser();

      // A change is allowed if it's exactly one more view, or a vote change
      // that matches the user's own vote.
      allow create, update: if isSchoolUser()
        && request.resource.data.keys().hasOnly(['up', 'down', 'views'])
        && (isOneMoreView() || isVoteChange());

      allow delete: if false;

      // ----- Comments: articles/{articleId}/comments/{commentId} -----
      match /comments/{commentId} {
        allow read: if isSchoolUser();
        allow create: if isSchoolUser()
          && request.resource.data.keys().hasOnly(['text', 'uid', 'username', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username == myUsername()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && withinCommentLimit();
        // You can delete your own comments. Editors can delete any comment,
        // and put one back with Undo.
        allow delete: if isSchoolUser() && (isEditor() || resource.data.uid == request.auth.uid);
        allow create: if isEditor()
          && request.resource.data.keys().hasOnly(['text', 'uid', 'username', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
      }
    }

    // ---------- Events: events/{eventId} ----------
    // { title, body, createdAt, start, end, dateKind, dateText }
    // Everyone can read events. Editors add, edit and delete them (and Undo
    // puts a deleted event back exactly as it was).
    function validEvent(d) {
      return d.keys().hasOnly(['title', 'body', 'createdAt', 'start', 'end', 'dateKind', 'dateText'])
        && d.keys().hasAll(['title', 'body', 'createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.body is string && d.body.size() <= 20000
        && d.createdAt is timestamp
        && (!('start' in d) || (
          d.keys().hasAll(['start', 'end', 'dateKind', 'dateText'])
          && d.start is timestamp && d.end is timestamp && d.end >= d.start
          && d.dateKind in ['day', 'range', 'until', 'month']
          && d.dateText is string && d.dateText.size() <= 100));
    }

    match /events/{eventId} {
      allow read: if isSchoolUser();
      allow create: if isEditor() && validEvent(request.resource.data);
      allow update: if isEditor()
        && validEvent(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isEditor();
    }

    // ---------- Student Art ----------
    // art/{artId}       { type, title, artist, description, text, link, hasImage, createdAt }
    // artImages/{artId} { data }  the shrunk picture (stored separately so it loads only when needed)
    // Everyone can look; editors add, edit and delete.
    function validArt(d) {
      return d.keys().hasOnly(['type', 'title', 'artist', 'description', 'text', 'link', 'hasImage', 'createdAt'])
        && d.type in ['image', 'text', 'video', 'audio']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.artist is string && d.artist.size() > 0 && d.artist.size() <= 100
        && d.description is string && d.description.size() <= 5000
        && d.get('text', '') is string && d.get('text', '').size() <= 20000
        && d.get('link', '') is string && d.get('link', '').size() <= 1000
        && d.createdAt is timestamp;
    }

    match /art/{artId} {
      allow read: if isSchoolUser();
      allow create: if isEditor() && validArt(request.resource.data);
      allow update: if isEditor()
        && validArt(request.resource.data)
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isEditor();
    }

    match /artImages/{artId} {
      allow read: if isSchoolUser();
      allow create, update: if isEditor()
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 1000000;
      allow delete: if isEditor();
    }

    // ---------- Club Information ----------
    // clubs/{clubId}       { name, advisor, meetingDay, meetingTime, room,
    //                        description, hasImage, createdAt, updatedAt }
    // clubImages/{clubId}  { data }  the club's shrunk picture
    // Everyone can look; editors add, edit and delete.
    // (Club Leaders will be allowed to edit their own club in Step 16.)
    // An optional detail (advisor, meeting day, time, room): text up to 200 characters
    function shortText(d, key) {
      return !(key in d) || (d[key] is string && d[key].size() <= 200);
    }
    function validClub(d) {
      return d.keys().hasOnly(['name', 'advisor', 'meetingDay', 'meetingTime', 'room',
                               'description', 'hasImage', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'description', 'hasImage', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && shortText(d, 'advisor') && shortText(d, 'meetingDay')
        && shortText(d, 'meetingTime') && shortText(d, 'room')
        && d.description is string && d.description.size() <= 20000
        && d.hasImage is bool
        && d.createdAt is timestamp
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    match /clubs/{clubId} {
      allow read: if isSchoolUser();
      allow create: if isEditor() && validClub(request.resource.data);
      allow update: if isEditor()
        && validClub(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      // Club Leaders (Step 16): only their own club, only its text and picture
      allow update: if isSchoolUser()
        && leadsClub(clubId)
        && validClub(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'hasImage', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if isEditor();
    }

    match /clubImages/{clubId} {
      allow read: if isSchoolUser();
      allow create, update: if (isEditor() || (isSchoolUser() && leadsClub(clubId)))
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 1000000;
      allow delete: if isEditor() || (isSchoolUser() && leadsClub(clubId));
    }

    // ---------- Q&A (Step 10) ----------
    // qa/{questionId}      { text, uid, username, createdAt, up, down }
    // qaReplies/{replyId}  { questionId, text, uid, username, createdAt }
    // 500 characters at most. 5 questions + replies per day for students
    // (withinQALimit above). Editors can delete anything, and Undo puts it back.
    match /qa/{questionId} {
      allow read: if isSchoolUser();
      allow create: if isSchoolUser()
        && request.resource.data.keys().hasOnly(['text', 'uid', 'username', 'createdAt', 'up', 'down'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == myUsername()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.up == 0
        && request.resource.data.down == 0
        && withinQALimit();
      // Votes: only up/down change, and only to match your own vote
      allow update: if isSchoolUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['up', 'down'])
        && qaVoteAfter(questionId) != qaVoteBefore(questionId)
        && request.resource.data.up - resource.data.up == upChange(qaVoteBefore(questionId), qaVoteAfter(questionId))
        && request.resource.data.down - resource.data.down == downChange(qaVoteBefore(questionId), qaVoteAfter(questionId));
      // You can delete your own question; editors can delete any
      allow delete: if isSchoolUser() && (isEditor() || resource.data.uid == request.auth.uid);
      // Undo: an editor puts a deleted question back as it was
      allow create: if isEditor()
        && request.resource.data.keys().hasOnly(['text', 'uid', 'username', 'createdAt', 'up', 'down'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.up is int
        && request.resource.data.down is int;
    }

    match /qaReplies/{replyId} {
      allow read: if isSchoolUser();
      allow create: if isSchoolUser()
        && request.resource.data.keys().hasOnly(['questionId', 'text', 'uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == myUsername()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.questionId is string
        && exists(/databases/$(database)/documents/qa/$(request.resource.data.questionId))
        && withinQALimit();
      allow update: if false;
      // You can delete your own reply; the question's author can delete the
      // replies to it (when deleting the question); editors can delete any
      allow delete: if isSchoolUser() && (isEditor()
        || resource.data.uid == request.auth.uid
        || (exists(/databases/$(database)/documents/qa/$(resource.data.questionId))
            && get(/databases/$(database)/documents/qa/$(resource.data.questionId)).data.uid == request.auth.uid));
      // Undo (may happen together with putting its question back)
      allow create: if isEditor()
        && request.resource.data.keys().hasOnly(['questionId', 'text', 'uid', 'username', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt is timestamp;
    }

    // ---------- Lost Items (Step 11) ----------
    // lostItems/{id}  { text, uid, username, createdAt, updatedAt? }
    // Anyone adds (200 characters, 1 per day for students), edits or deletes
    // their own. Editors can delete any (and put it back with Undo).
    // The daily GitHub Action deletes entries older than 14 days.
    match /lostItems/{itemId} {
      allow read: if isSchoolUser();
      allow create: if isSchoolUser()
        && request.resource.data.keys().hasOnly(['text', 'uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == myUsername()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        && request.resource.data.createdAt == request.time
        && withinLostLimit();
      allow update: if isSchoolUser()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSchoolUser() && (resource.data.uid == request.auth.uid || isEditor());
      // Undo: an editor puts a deleted entry back as it was
      allow create: if isEditor()
        && request.resource.data.keys().hasOnly(['text', 'uid', 'username', 'createdAt', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200
        && request.resource.data.createdAt is timestamp;
    }

    // ---------- Daily Poll (Step 12) ----------
    // site/poll  { name, url, pollId, createdAt }  (only one poll at a time)
    // Everyone can see it; editors add, replace and remove it.
    match /site/{docId} {
      allow read: if isSchoolUser();
      allow create, update: if isEditor() && docId == 'poll'
        && request.resource.data.keys().hasOnly(['name', 'url', 'pollId', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 1000
        && request.resource.data.url.matches('https://(forms[.]office[.]com|forms[.]microsoft[.]com|forms[.]cloud[.]microsoft)/.*')
        && request.resource.data.pollId is string
        && request.resource.data.pollId.size() <= 40
        && request.resource.data.createdAt is timestamp;
      allow delete: if isEditor();
    }

    // ---------- Miscellaneous: school map (Step 9) ----------
    // siteImages/map  { data }  the shrunk map picture
    // Everyone can look; editors upload a new one (or remove it with Undo).
    match /siteImages/{imageId} {
      allow read: if isSchoolUser();
      allow create, update: if isEditor() && imageId == 'map'
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 1000000;
      allow delete: if isEditor();
    }

    // ---------- Editor check ----------
    // The website asks for editorCheck/{your id}. Only editors are allowed to,
    // which is how the page learns you're an editor without a second list.
    match /editorCheck/{userId} {
      allow get: if isEditor() && isOwner(userId);
    }

    // Everything else is locked until later steps open it up.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
